<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="refresh" content="120">
<title>Ultra Status</title>
<link rel="icon" type="image/svg+xml" href="{{ favicon_svg }}">
<link rel="icon" type="image/png" sizes="32x32" href="{{ favicon_png }}">
<style>
:root {
  color-scheme: light dark;
  --bg: #ffffff;
  --surface: #f6f8fa;
  --border: #d0d7de;
  --ink: #1f2328;
  --ink-2: #57606a;
  --link: #0969da;
  --ok-fg: #1a7f37;       --ok-bg: #dafbe1;
  --minor-fg: #9a6700;    --minor-bg: #fff8c5;
  --major-fg: #bc4c00;    --major-bg: #fff1e5;
  --critical-fg: #cf222e; --critical-bg: #ffebe9;
  --stale-fg: #57606a;    --stale-bg: #eaeef2;
  --map-land: #e6e9ee;    --map-stroke: #b6bec8;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0d1117;
    --surface: #161b22;
    --border: #30363d;
    --ink: #e6edf3;
    --ink-2: #8b949e;
    --link: #58a6ff;
    --ok-fg: #3fb950;       --ok-bg: #12261e;
    --minor-fg: #d29922;    --minor-bg: #2b2410;
    --major-fg: #f0883e;    --major-bg: #2f1a0a;
    --critical-fg: #f85149; --critical-bg: #2e1214;
    --stale-fg: #8b949e;    --stale-bg: #21262d;
    --map-land: #21262d;    --map-stroke: #3d444d;
  }
}
.map-wrap { border: 1px solid var(--border); border-radius: 8px; background: var(--surface); padding: 0.5rem; margin-bottom: 0.75rem; }
svg.map { display: block; }
svg.map .land { fill: var(--map-land); stroke: var(--map-stroke); stroke-width: 0.5; }
svg.map .marker { stroke: var(--map-stroke); stroke-width: 1; }
svg.map .marker-ok       { fill: var(--ok-fg); }
svg.map .marker-minor    { fill: var(--minor-fg); }
svg.map .marker-major    { fill: var(--major-fg); }
svg.map .marker-critical { fill: var(--critical-fg); }
svg.map .marker-stale    { fill: var(--stale-fg); }
svg.map .marker-other    { opacity: 0.4; }
.banner { margin: 0 0 1rem; padding: 0.6rem 0.9rem; border-radius: 8px; font-weight: 600; }
.banner-clear { color: var(--ok-fg); background: var(--ok-bg); }
.banner-open  { color: var(--major-fg); background: var(--major-bg); }
.tile .elsewhere { color: var(--ink-2); opacity: 0.75; }
details.elsewhere-block { margin: 0.5rem 0 2rem; }
details.elsewhere-block summary { cursor: pointer; color: var(--ink-2); font-weight: 600; padding: 0.25rem 0; }
details.elsewhere-block .table-wrap { margin-top: 0.5rem; margin-bottom: 0; }
.legend .swatch-big { width: 0.9rem; height: 0.9rem; background: var(--ok-fg); }
.chip { display: inline-block; padding: 0.05rem 0.45rem; border-radius: 5px; font-weight: 600; font-size: 0.8em; text-transform: uppercase; }
svg.map .marker { cursor: pointer; outline: none; }
svg.map .marker:focus-visible { stroke: var(--link); stroke-width: 2; }
svg.map .cards-layer { pointer-events: none; overflow: visible; }
svg.map .cards { position: relative; width: 100%; height: 100%; font: 11px/1.35 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; color: var(--ink); }
/* Hidden cards use visibility, not pointer-events, so the grace period after
   leaving a marker keeps the card hoverable while the pointer travels to it.
   Shown: no delay. Hidden: stay fully visible 450 ms, then fade, then vanish. */
svg.map .card { position: absolute; width: 22%; box-sizing: border-box; padding: 8px; border: 1px solid var(--border);
  border-radius: 6px; background: var(--surface); opacity: 0; visibility: hidden; pointer-events: auto;
  transition: opacity 0.15s ease 0.45s, visibility 0s linear 0.6s; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12); }
@media (prefers-color-scheme: dark) { svg.map .card { box-shadow: none; } }
svg.map .card:hover { opacity: 1; visibility: visible; transition-delay: 0s; }
svg.map .card-head { margin-bottom: 4px; }
svg.map .card-tags { display: flex; flex-wrap: wrap; gap: 4px; align-items: center; margin-bottom: 4px; }
svg.map .card .chip { padding: 1px 5px; border-radius: 4px; font-size: 9px; }
svg.map .card ul { list-style: none; margin: 0; padding: 0; }
svg.map .card li { margin: 3px 0; }
svg.map .card a { color: var(--link); }
svg.map .card .muted { color: var(--ink-2); }
svg.map .card .mine-tag { color: var(--ok-fg); font-weight: 600; font-size: 9px; }
svg.map .card.pinned { opacity: 1; visibility: visible; transition-delay: 0s; }
svg.map { touch-action: none; outline: none; }
svg.map:focus-visible { outline: 2px solid var(--link); outline-offset: 2px; border-radius: 6px; }
svg.map g.viewport { transform-origin: 0 0; }
svg.map g.viewport.animate { transition: transform 250ms ease; }
@media (prefers-reduced-motion: reduce) { svg.map g.viewport.animate { transition: none; } }
svg.map text.label { display: none; font: 11px system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; fill: var(--ink-2); pointer-events: none; }
svg.map.zoomed text.label { display: block; }
.map-toolbar { display: flex; flex-wrap: wrap; gap: 0.35rem; align-items: center; margin-bottom: 0.5rem; }
.map-toolbar button { font: inherit; font-size: 0.85rem; padding: 0.25rem 0.6rem; border: 1px solid var(--border); border-radius: 6px; background: var(--surface); color: var(--ink); cursor: pointer; }
.map-toolbar button:hover { border-color: var(--link); }
.map-toolbar .zoom-buttons { margin-left: auto; display: flex; gap: 0.35rem; }
.map-toolbar .zoom-buttons button { min-width: 2.2rem; font-weight: 700; }
.map-toolbar .hint { color: var(--ink-2); font-size: 0.8rem; }
/* Cloud toggles: pure CSS. An unchecked box hides that cloud's markers, labels, and cards. */
.map-wrap { position: relative; }
.cloud-toggles { position: absolute; top: 0.75rem; right: 0.75rem; z-index: 1; display: flex; flex-direction: column; gap: 0.2rem;
  padding: 0.45rem 0.6rem; border: 1px solid var(--border); border-radius: 6px; background: var(--surface); font-size: 0.8rem; }
.cloud-toggles label { display: flex; align-items: center; gap: 0.35rem; cursor: pointer; }
.cloud-toggles .swatch { width: 0.6rem; height: 0.6rem; border-radius: 50%; border: 1px solid var(--map-stroke); background: var(--ok-fg); }
.map-wrap:has(#toggle-aws:not(:checked))   svg.map [data-cloud="aws"]   { display: none; }
.map-wrap:has(#toggle-gcp:not(:checked))   svg.map [data-cloud="gcp"]   { display: none; }
.map-wrap:has(#toggle-azure:not(:checked)) svg.map [data-cloud="azure"] { display: none; }
{{ map_css | safe }}
.global-list { list-style: none; padding: 0; margin: 0 0 0.75rem; display: flex; flex-direction: column; gap: 0.25rem; }
.global-list li { font-size: 0.9rem; }
.global-list .level { display: inline-block; padding: 0.05rem 0.45rem; border-radius: 5px; font-weight: 600; font-size: 0.8rem; text-transform: uppercase; margin-right: 0.35rem; }
.legend { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.25rem; font-size: 0.85rem; color: var(--ink-2); margin-bottom: 2rem; }
.legend .swatch { display: inline-block; width: 0.7rem; height: 0.7rem; border-radius: 50%; border: 1px solid var(--map-stroke); vertical-align: -1px; margin-right: 0.3rem; }
.legend svg { vertical-align: middle; margin-right: 0.3rem; }
* { box-sizing: border-box; }
body { margin: 0; padding: 1.5rem; background: var(--bg); color: var(--ink);
  font: 15px/1.45 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
a { color: var(--link); }
header { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem 1.5rem; margin-bottom: 1.25rem; }
header h1 { font-size: 1.5rem; margin: 0; }
header .meta { color: var(--ink-2); font-size: 0.9rem; }
/* Groups flow left to right and wrap, so one-tile groups share a row. */
.groups { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 1.5rem 2rem; margin-bottom: 2rem; }
/* A group keeps its natural width and wraps as a whole. Only a group wider
   than the viewport lets its own tiles wrap. */
section.group { flex: 0 0 auto; max-width: 100%; }
section.group h2 { font-size: 1.15rem; margin: 0 0 0.5rem; display: flex; align-items: center; gap: 0.5rem; }
section.group h2 .muted { color: var(--ink-2); font-weight: 400; font-size: 0.9rem; }
.tiles { display: flex; flex-wrap: wrap; gap: 0.75rem; }
/* A fixed width, not a flex basis: only a width counts toward the group's
   intrinsic size, so the group grows to fit its tiles in one row. */
.tile { flex: 0 0 auto; width: 11.5rem; }
.tile { border: 1px solid var(--border); border-radius: 8px; padding: 0.75rem 0.9rem; background: var(--surface); }
.tile h2 { font-size: 1rem; margin: 0 0 0.35rem; font-weight: 600; }
.tile .level { display: inline-block; font-size: 1.15rem; font-weight: 700; text-transform: uppercase;
  letter-spacing: 0.02em; padding: 0.15rem 0.5rem; border-radius: 6px; }
.tile .count, .tile .polled { color: var(--ink-2); font-size: 0.85rem; margin-top: 0.35rem; }
.tile .error { color: var(--critical-fg); font-size: 0.85rem; margin-top: 0.35rem; word-break: break-word; }
.level-ok       { color: var(--ok-fg);       background: var(--ok-bg); }
.level-minor    { color: var(--minor-fg);    background: var(--minor-bg); }
.level-major    { color: var(--major-fg);    background: var(--major-bg); }
.level-critical { color: var(--critical-fg); background: var(--critical-bg); }
.level-stale    { color: var(--stale-fg);    background: var(--stale-bg); }
.tile.level-ok, .tile.level-minor, .tile.level-major, .tile.level-critical, .tile.level-stale { background: var(--surface); color: var(--ink); }
.tile.level-critical { border-color: var(--critical-fg); }
.tile.level-major    { border-color: var(--major-fg); }
section h2 { font-size: 1.15rem; margin: 0 0 0.5rem; }
.table-wrap { overflow-x: auto; margin-bottom: 2rem; }
table { border-collapse: collapse; width: 100%; font-size: 0.9rem; }
th, td { text-align: left; vertical-align: top; padding: 0.45rem 0.6rem; border-bottom: 1px solid var(--border); }
th { color: var(--ink-2); font-weight: 600; white-space: nowrap; }
td.sev span { display: inline-block; padding: 0.05rem 0.45rem; border-radius: 5px; font-weight: 600; font-size: 0.8rem; text-transform: uppercase; }
td.when { white-space: nowrap; color: var(--ink-2); }
td.regions { font-size: 0.8rem; color: var(--ink-2); }
td.msg { max-width: 34rem; color: var(--ink-2); }
.empty { color: var(--ink-2); padding: 0.5rem 0 1.5rem; }
footer { color: var(--ink-2); font-size: 0.85rem; border-top: 1px solid var(--border); padding-top: 1rem; }
footer ul { list-style: none; padding: 0; margin: 0.25rem 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; }
</style>
</head>
<body>
<header>
  <h1>Ultra Status</h1>
  <span class="meta">Generated {{ generated_at | ts }}. Refreshes every 2 minutes.</span>
</header>

{% if filter_active %}
<p class="banner {{ 'banner-clear' if all_clear else 'banner-open' }}">
  {% if all_clear %}
  All clear in your regions: {{ my_region_labels | join(', ') }}
  {% else %}
  {{ open | length }} open incident{{ '' if open | length == 1 else 's' }} in your regions
  {% endif %}
</p>
{% endif %}

{% if global_incidents %}
<ul class="global-list">
{% for i in global_incidents %}
  <li><span class="level level-{{ i.severity }}">{{ i.severity }}</span>Global: {{ i.provider_label }} {% if i.url %}<a href="{{ i.url }}">{{ i.title }}</a>{% else %}{{ i.title }}{% endif %}</li>
{% endfor %}
</ul>
{% endif %}

<div class="map-toolbar" hidden>
  <button type="button" data-preset="world">World</button>
  <button type="button" data-preset="north-america">N. America</button>
  <button type="button" data-preset="south-america">S. America</button>
  <button type="button" data-preset="europe">Europe</button>
  <button type="button" data-preset="middle-east-africa">Middle East &amp; Africa</button>
  <button type="button" data-preset="asia">Asia</button>
  <button type="button" data-preset="oceania">Oceania</button>
  {% if filter_active %}
  <button type="button" data-preset="mine">My regions</button>
  {% endif %}
  <span class="hint">Scroll to zoom, drag to pan, click a marker to pin its card</span>
  <span class="zoom-buttons">
    <button type="button" data-zoom="in" aria-label="Zoom in">+</button>
    <button type="button" data-zoom="out" aria-label="Zoom out">-</button>
  </span>
</div>

<div class="map-wrap">
<form class="cloud-toggles" aria-label="Show clouds on the map">
  <label><input type="checkbox" id="toggle-aws" checked> <span class="swatch"></span>AWS</label>
  <label><input type="checkbox" id="toggle-gcp" checked> <span class="swatch"></span>GCP</label>
  <label><input type="checkbox" id="toggle-azure" checked> <span class="swatch"></span>Azure</label>
</form>
{{ map_svg | safe }}
</div>

<div class="legend">
  <span><span class="swatch" style="background: var(--ok-fg)"></span>ok</span>
  <span><span class="swatch" style="background: var(--minor-fg)"></span>minor</span>
  <span><span class="swatch" style="background: var(--major-fg)"></span>major</span>
  <span><span class="swatch" style="background: var(--critical-fg)"></span>critical</span>
  <span><span class="swatch" style="background: var(--stale-fg)"></span>stale</span>
  <span>
    <svg width="34" height="20" viewBox="-12 -8 34 20" aria-hidden="true">
      <circle cx="-7" cy="5" r="5" fill="var(--ok-fg)" stroke="var(--map-stroke)"/>
      <circle cx="0" cy="0" r="5" fill="var(--ok-fg)" stroke="var(--map-stroke)"/>
      <circle cx="7" cy="5" r="5" fill="var(--ok-fg)" stroke="var(--map-stroke)"/>
    </svg>Azure left, AWS centre, GCP right
  </span>
  <span>Databricks incidents are shown on their host cloud's marker.</span>
  {% if filter_active %}
  <span><span class="swatch swatch-big"></span>large = your regions</span>
  {% endif %}
</div>

<div class="groups">
{% for g in groups %}
<section class="group">
  <h2>
    {{ g.label }}
    <span class="chip level-{{ g.level }}">{{ g.level }}</span>
    {% if g.open_count %}
    <span class="muted">{{ g.open_count }} open{% if filter_active and g.has_regions %} in your regions{% endif %}</span>
    {% endif %}
  </h2>
<div class="tiles">
{% for p in g.providers %}
  <div class="tile level-{{ p.level }}">
    <h2>{{ p.label }}</h2>
    <span class="level level-{{ p.level }}">{{ p.level }}</span>
    {% if filter_active and p.has_regions %}
    <div class="count">{{ p.open_count }} open in your regions</div>
    {% if p.elsewhere_count %}
    <div class="count elsewhere">{{ p.elsewhere_count }} elsewhere</div>
    {% endif %}
    {% else %}
    <div class="count">{{ p.open_count }} open incident{{ '' if p.open_count == 1 else 's' }}</div>
    {% endif %}
    {% if p.poll_error %}
    <div class="error">Poll failed: {{ p.poll_error }}</div>
    {% elif p.polled_ago %}
    <div class="polled">polled {{ p.polled_ago }}</div>
    {% else %}
    <div class="polled">never polled</div>
    {% endif %}
  </div>
{% endfor %}
</div>
</section>
{% endfor %}
</div>

{% macro incident_rows(rows, show_resolved) %}
{% for i in rows %}
  <tr>
    <td>{{ i.provider_label }}</td>
    <td class="sev"><span class="level-{{ i.severity }}">{{ i.severity }}</span></td>
    <td>{% if i.url %}<a href="{{ i.url }}">{{ i.title }}</a>{% else %}{{ i.title }}{% endif %}</td>
    <td class="when">{{ i.started_at | ts }}</td>
    <td class="when">{{ i.updated_at | ts }}</td>
    {% if show_resolved %}
    <td class="when">{{ i.resolved_at | ts }}</td>
    {% endif %}
    <td class="regions">{{ i.region_labels | join(', ') }}</td>
    <td class="msg" title="{{ i.last_message_full }}">{{ i.last_message }}</td>
  </tr>
{% endfor %}
{% endmacro %}

{% macro open_table(rows) %}
  <div class="table-wrap">
  <table>
    <thead><tr><th>Provider</th><th>Severity</th><th>Title</th><th>Started</th><th>Updated</th><th>Regions</th><th>Last message</th></tr></thead>
    <tbody>{{ incident_rows(rows, false) }}</tbody>
  </table>
  </div>
{% endmacro %}

{% macro resolved_table(rows) %}
  <div class="table-wrap">
  <table>
    <thead><tr><th>Provider</th><th>Severity</th><th>Title</th><th>Started</th><th>Updated</th><th>Resolved</th><th>Regions</th><th>Last message</th></tr></thead>
    <tbody>{{ incident_rows(rows, true) }}</tbody>
  </table>
  </div>
{% endmacro %}

<section>
  <h2>{% if filter_active %}Open in your regions{% else %}Open incidents{% endif %}</h2>
  {% if open %}
  {{ open_table(open) }}
  {% else %}
  <p class="empty">{% if filter_active %}No open incidents in your regions.{% else %}No open incidents.{% endif %}</p>
  {% endif %}
  {% if open_elsewhere %}
  <details class="elsewhere-block">
    <summary>Open elsewhere ({{ open_elsewhere | length }})</summary>
    {{ open_table(open_elsewhere) }}
  </details>
  {% endif %}
</section>

<section>
  <h2>{% if filter_active %}Resolved in your regions, last 7 days{% else %}Resolved in the last 7 days{% endif %}</h2>
  {% if resolved %}
  {{ resolved_table(resolved) }}
  {% else %}
  <p class="empty">{% if filter_active %}Nothing resolved in your regions in the last 7 days.{% else %}Nothing resolved in the last 7 days.{% endif %}</p>
  {% endif %}
  {% if resolved_elsewhere %}
  <details class="elsewhere-block">
    <summary>Resolved elsewhere ({{ resolved_elsewhere | length }})</summary>
    {{ resolved_table(resolved_elsewhere) }}
  </details>
  {% endif %}
</section>

<footer>
  Sources
  <ul>
  {% for p in providers %}
    <li><a href="{{ p.source_url }}">{{ p.label }}</a></li>
  {% endfor %}
  </ul>
</footer>
<script>{{ map_js | safe }}</script>
</body>
</html>
